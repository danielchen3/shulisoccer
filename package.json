{
  "name": "shulisoccer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names vite,wrangler \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wrangler pages dev --proxy 127.0.0.1:5173 --port 8788 --persist-to=.wrangler/state\"",
    "dev:frontend": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "npm run typecheck:app && npm run typecheck:functions && npm run typecheck:queues",
    "typecheck:app": "tsc -p tsconfig.app.json",
    "typecheck:functions": "tsc -p functions/tsconfig.json",
    "typecheck:queues": "tsc -p tsconfig.queues.json",
    "check": "npm run typecheck && npm run build",
    "test:smoke": "node scripts/smoke-test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply shulisoccer --local --persist-to=.wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply shulisoccer --remote",
    "cache:create": "wrangler kv namespace create PUBLIC_CACHE",
    "queues:create": "wrangler queues create shulisoccer-comment-events --message-retention-period-secs 86400",
    "queues:deploy": "wrangler deploy --config wrangler.comment-events.toml"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "tailwind-scrollbar": "^4.0.2",
    "yet-another-react-lightbox": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250525.0",
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "wrangler": "^3.114.4"
  }
}
